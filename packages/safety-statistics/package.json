{
  "name": "@pshkv/safety-statistics",
  "version": "0.1.0",
  "description": "Statistical safety metrics for SINT Protocol agents (MTBF, nines of reliability, error budgets)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": ["dist", "README.md"],
  "license": "Apache-2.0"
}
