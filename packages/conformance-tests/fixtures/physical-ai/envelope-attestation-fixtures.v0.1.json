{
  "fixtureId": "physical-envelope-attestation-v0.1",
  "schemaVersion": "0.1.0",
  "description": "Protocol-neutral adversarial vectors for evidence-to-envelope state transitions and execution binding.",
  "profile": {
    "condition": "fence_closed",
    "requiredScope": "robot-7:cell-a:working",
    "trustedSources": ["safety-plc-a", "safety-plc-b"],
    "maxTtlSeconds": 60,
    "currentBootEpoch": "boot-7",
    "fallbackEnvelope": "transport",
    "authorizedEnvelope": "working",
    "digestAlgorithm": "sha256",
    "canonicalization": "recursive-key-sort; evidence-array-sorted-by-canonical-value"
  },
  "cases": [
    {
      "id": "valid_fresh_scoped_positive_control",
      "description": "Fresh verified TRUE evidence activates an already-authorized envelope and a decision bound to that evidence may execute.",
      "nowMs": 2000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 2, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "working", "execution": "allow_bound_execution", "reason": "fresh_verified_true" }
    },
    {
      "id": "newer_false_retracts_true",
      "description": "A newer verified FALSE retracts an earlier TRUE regardless of list position.",
      "nowMs": 2000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 1, "issuedAtMs": 900, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" },
        { "source": "safety-plc-a", "condition": "fence_closed", "value": false, "sequence": 2, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "latest_reading_false" }
    },
    {
      "id": "newer_false_retracts_true_reversed_input",
      "description": "The same readings in reverse order produce the same safe state.",
      "nowMs": 2000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": false, "sequence": 2, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" },
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 1, "issuedAtMs": 900, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "latest_reading_false" }
    },
    {
      "id": "expired_true_demotes",
      "description": "Expired TRUE evidence cannot keep the permissive envelope active.",
      "nowMs": 5000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 3, "issuedAtMs": 1000, "ttlSeconds": 1, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "no_current_verified_true" }
    },
    {
      "id": "junk_proof_demotes",
      "description": "A populated proof field that fails authentication cannot activate an envelope.",
      "nowMs": 2000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 4, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "invalid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "no_current_verified_true" }
    },
    {
      "id": "verifier_outage_demotes",
      "description": "Loss of verification makes the permissive envelope ineligible and blocks execution.",
      "nowMs": 2000,
