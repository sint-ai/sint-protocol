      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 7, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" },
        { "source": "safety-plc-a", "condition": "fence_closed", "value": false, "sequence": 7, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "equal_sequence_conflict" }
    },
    {
      "id": "trusted_source_disagreement_demotes",
      "description": "Disagreement between trusted sources fails closed until a quorum policy is declared.",
      "nowMs": 2000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 8, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" },
        { "source": "safety-plc-b", "condition": "fence_closed", "value": false, "sequence": 3, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "trusted_source_disagreement" }
    },
    {
      "id": "restart_replay_wrong_boot_epoch",
      "description": "Evidence from a previous boot epoch cannot be replayed after verifier restart.",
      "nowMs": 2000,
      "verifierState": "available",
      "evidence": [
        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 99, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-6", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "no_current_verified_true" }
