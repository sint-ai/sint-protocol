        { "source": "safety-plc-a", "condition": "fence_closed", "value": true, "sequence": 5, "issuedAtMs": 1000, "ttlSeconds": 60, "scope": "robot-7:cell-a:working", "bootEpoch": "boot-7", "proofStatus": "valid" }
      ],
      "authorizationEvidenceBinding": "computed",
      "expected": { "activeEnvelope": "transport", "execution": "deny_execution", "reason": "verifier_unavailable" }
