{
  "fixtureId": "envelope-attestation-adversarial-v0.1",
  "schemaVersion": "0.1.0",
  "profile": "physical-envelope-attestation-profile/v0.1",
  "license": "Apache-2.0",
  "description": "Shared adversarial fixture for condition-evidence → envelope selection → execution authorization. Co-designed with DriftCore OS / LifeCore-16. An implementation passes only if valid evidence activates the pre-authorized envelope AND every adversarial path leaves the tighter envelope active.",
  "provenance": {
    "requirementsSource": "Justin Gracie (DriftCore OS) review thread, five fixture requirements, 2026-09",
    "sintReferenceRunner": "packages/conformance-tests/src/envelope-attestation-adversarial-conformance.test.ts",
    "notes": [
      "All times are millisecond offsets from `clock.epoch`. Runners must use an injectable clock; wall-clock runners are non-conforming.",
      "Signer keys are generated per run by the runner. Only the trust relationships in `signers` are normative.",
      "`outcome` is protocol-neutral: `pass` = the commanded value is inside the effective envelope and normal authorization continues; `violation` = the commanded value is outside the effective envelope; `refused` = the authorization layer declined to decide because the envelope source was unavailable and the deployment configured deny.",
      "The effective envelope is min(authorizedLimits, activeEnvelope). Evidence may activate a pre-authorized envelope; it never widens beyond `authorizedLimits`.",
      "A probe outside `authorizedLimits` may be refused by the authority layer before envelope selection runs (case 5b); such a violation need not carry an envelope binding."
    ]
  },
  "clock": {
    "epoch": "2026-09-22T00:00:00.000Z"
  },
  "signers": {
    "fence-plc-a": {
      "trusted": true
    },
    "fence-plc-b": {
      "trusted": true
    },
    "rogue": {
      "trusted": false
    }
  },
  "deployment": {
    "authorizedLimits": {
      "maxVelocityMps": 1.5,
      "maxForceNewtons": 150
    },
    "baseline": {
      "envelopeId": "cell-a/collaborative",
      "limits": {
        "maxVelocityMps": 0.25,
        "maxForceNewtons": 50
      }
    },
    "permissive": {
      "envelopeId": "cell-a/fenced",
      "limits": {
        "maxVelocityMps": 1.5,
        "maxForceNewtons": 150
      },
      "requires": [
        {
          "condition": "fence_closed",
          "value": true,
          "minSources": 1
        }
      ]
    },
    "maxTtlMs": 10000,
    "maxClockSkewMs": 1000,
    "selectorFailurePolicy": {
      "mode": "fallback",
      "fallback": {
        "maxVelocityMps": 0.25,
        "maxForceNewtons": 50
      }
    }
  },
  "probe": {
    "resource": "ros2:///cmd_vel",
    "action": "publish",
    "commandedVelocityMps": 1.0
  },
  "cases": [
