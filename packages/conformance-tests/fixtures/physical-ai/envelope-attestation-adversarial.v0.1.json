            "condition": "fence_closed",
            "value": true,
            "sequence": 1,
            "issuedAt": 0,
            "ttlMs": 5000
          },
          "expect": {
            "accepted": true
          }
        },
        {
          "op": "probe",
          "at": 100,
          "expect": {
            "activeEnvelope": "cell-a/fenced",
            "outcome": "pass",
            "events": [
              "envelope.applied"
