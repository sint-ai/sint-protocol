  "tokenBoundAuthority": {
    "extensionName": "regulatedDataPolicy",
    "signedFields": [
      "allowedDataClasses",
      "allowedPurposes",
      "approvedProcessors",
      "approvedRegions",
      "approvedModels",
      "allowedContextFields",
      "allowFallback"
    ],
    "signaturePayloadIncludesExtension": true,
    "deploymentPolicyCannotExpandToken": true,
    "delegationAttenuationOnly": true,
    "parentPolicy": {
      "allowedDataClasses": [
        "PHI",
        "PII"
      ],
      "allowedPurposes": [
        "TREAT",
        "PAYMENT"
      ],
      "approvedProcessors": [
        "ehr-core",
        "in-region-model-router",
        "billing-service"
      ],
      "approvedRegions": [
        "us-east-1",
        "us-west-2"
      ],
      "approvedModels": [
        "clinical-summary-local",
        "intake-triage-approved",
        "billing-code-helper"
      ],
      "allowedContextFields": [
        "symptoms",
        "medications",
        "insurance_plan"
      ],
      "allowFallback": true
    },
    "validDelegation": {
      "allowedDataClasses": [
        "PHI"
      ],
      "allowedPurposes": [
        "TREAT"
      ],
      "approvedProcessors": [
        "in-region-model-router"
      ],
      "approvedRegions": [
        "us-east-1"
      ],
      "approvedModels": [
        "clinical-summary-local"
      ],
      "allowedContextFields": [
        "symptoms"
      ],
      "allowFallback": false
    },
    "invalidDelegations": [
