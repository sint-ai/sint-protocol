  "privacyPreservingEvidenceRules": [
    {
      "sensor": "camera",
      "allowedEvidence": [
        "presence_boolean",
        "consent_gesture_digest",
        "device_attestation_ref"
      ],
      "forbiddenEvidence": [
        "raw_frame",
        "face_embedding",
        "identity_label"
      ]
    },
    {
      "sensor": "microphone",
      "allowedEvidence": [
        "intent_digest",
        "local_transcript_hash",
        "device_attestation_ref"
      ],
      "forbiddenEvidence": [
        "raw_audio",
        "voiceprint_embedding",
        "speaker_identification"
      ]
    },
    {
