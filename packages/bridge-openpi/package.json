{
  "name": "@pshkv/bridge-openpi",
  "version": "0.1.0",
  "description": "SINT bridge for authenticated OpenPI/VLA remote inference",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@pshkv/core": "workspace:*",
    "@pshkv/gate-capability-tokens": "workspace:*"
  },
  "devDependencies": { "typescript": "^5.7.0", "vitest": "^3.0.0" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/sint-ai/sint-protocol",
    "directory": "packages/bridge-openpi"
  }
}
